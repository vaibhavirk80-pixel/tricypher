
{
  "manifest_version": 3,
  "name": "TriCypher - AI Privacy Shield",
  "version": "1.2.0",
  "description": "Automatically protects sensitive information before prompts reach AI websites.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["request-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TriCypher Privacy Shield"
  }
}
